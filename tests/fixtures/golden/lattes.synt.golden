  987:5    keyword      mod=1 'DESCRIPTION'
  987:17   string       mod=0 'Categoria-pai do conceito no domínio Synesis'
  988:5    keyword      mod=1 'GUIDELINES'
  989:9    string       mod=2 'Escolha uma categoria:'
  990:9    string       mod=2 'Method      — algoritmos, técnicas, abordagens computacionais'
  991:23   string       mod=2 '(ex.: Genetic_Algorithm, Neural_Network, Integer_Programming)'
  992:9    string       mod=2 'Technology  — plataformas, ferramentas, stacks aplicadas'
  993:23   string       mod=2 '(ex.: Generative_AI, MLOps, Knowledge_Graph)'
  994:9    string       mod=2 'Knowledge   — domínios de conhecimento científico ou disciplinar'
  995:23   string       mod=2 '(ex.: Operations_Research, Graph_Theory, Statistics)'
  996:9    string       mod=2 'Innovation  — aplicações e produtos emergentes em contexto de negócio'
  997:23   string       mod=2 '(ex.: Agent_Systems, Real_Estate_Tech)'
  998:9    string       mod=2 'Economics   — domínios de negócio, mercado, finanças aplicadas'
  999:23   string       mod=2 '(ex.: Credit_Risk, Financial_Optimization)'
 1001:9    string       mod=2 'Use a categoria-pai mais próxima. Não crie subcategorias.'
 1002:9    string       mod=2 'Para conceitos que expressam um domínio de aplicação amplo (ex.:'
 1003:9    string       mod=2 'Machine_Learning, Artificial_Intelligence, Real_Estate_Tech), escolha'
 1004:9    string       mod=2 'a categoria que melhor captura esse campo de aplicação'
 1005:9    string       mod=2 '(ex.: Machine_Learning -> Method; Artificial_Intelligence -> Knowledge;'
 1006:9    string       mod=2 'Real_Estate_Tech -> Innovation).'
 1008:9    string       mod=2 'PARES COM FRONTEIRA IMPRECISA — use quando houver dúvida:'
 1010:9    string       mod=2 'Method vs Technology:'
 1011:11   string       mod=2 'Method      → algoritmo, técnica ou abordagem computacional — o que é'
 1012:25   string       mod=2 'feito metodologicamente (ex.: Genetic_Algorithm, BERT_Fine_Tuning,'
 1013:25   string       mod=2 'Gradient_Boosting, Integer_Programming).'
 1014:11   string       mod=2 'Technology  → plataforma, ferramenta, stack ou paradigma tecnológico —'
 1015:25   string       mod=2 'o ambiente ou infraestrutura em que métodos operam'
 1016:25   string       mod=2 '(ex.: MLOps, Knowledge_Graph, Generative_AI, Edge_Computing).'
 1017:11   string       mod=2 'Teste: o conceito nomeia um procedimento/algoritmo (Method) ou um'
 1018:11   string       mod=2 'sistema/plataforma habilitador (Technology)?'
 1020:9    string       mod=2 'Knowledge vs Innovation:'
 1021:11   string       mod=2 'Knowledge   → domínio disciplinar ou campo científico estabelecido, sem'
 1022:25   string       mod=2 'vínculo primário com produto ou negócio'
 1023:25   string       mod=2 '(ex.: Operations_Research, Graph_Theory, Information_Theory).'
 1024:11   string       mod=2 'Innovation  → aplicação emergente com impacto em produto ou mercado,'
 1025:25   string       mod=2 'mesmo que baseada em conhecimento científico'
 1026:25   string       mod=2 '(ex.: Agent_Systems, Real_Estate_Tech, Recommender_System).'
 1027:11   string       mod=2 'Teste: o conceito é um campo de estudo (Knowledge) ou uma aplicação'
 1028:11   string       mod=2 'com valor de produto (Innovation)?'
 1030:9    string       mod=2 'Economics vs Innovation:'
 1031:11   string       mod=2 'Economics   → grandeza, variável ou sistema de mercado/negócio avaliado'
 1032:25   string       mod=2 'em termos quantitativos ou de dimensionamento, sem ênfase'
 1033:25   string       mod=2 'em novidade de produto (ex.: Biogas_Consumption,'
 1034:25   string       mod=2 'Biomass_Demand, Credit_Risk).'
 1035:11   string       mod=2 'Innovation  → aplicação, produto ou sistema tecnológico emergente cujo'
 1036:25   string       mod=2 'valor está na novidade ou no potencial de mercado do'
 1037:25   string       mod=2 'artefato em si (ex.: Decentralized_Energy_System,'
 1038:25   string       mod=2 'Turbocharger, Agent_Systems).'
 1039:11   string       mod=2 'Teste: o conceito é uma grandeza ou insumo mensurável dentro de um'
