  758:9    string       mod=2 'TESTE DE REÚSO (contém proliferação de vocabulário no corpus):'
  759:9    string       mod=2 'Antes de cunhar um nome de nível 3, pergunte: "este termo'
  760:9    string       mod=2 'provavelmente aparecerá em outros currículos do corpus, ou é único a'
  761:9    string       mod=2 'este candidato?" Se for provavelmente único, prefira o nível 2. Alvo:'
  762:9    string       mod=2 'manter o vocabulário de conceitos do corpus abaixo de 300 nós distintos.'
  764:9    string       mod=2 'DIVISÃO DE COMPOSTOS: se "e" une dois construtos distintos com padrões'
  765:9    string       mod=2 'relacionais diferentes, divida em dois conceitos e ligue-os por chain.'
  766:9    string       mod=2 'Errado: Otimizacao_E_Aprendizado_De_Maquina'
  767:9    string       mod=2 'Certo:  Combinatorial_Optimization, Machine_Learning (ligados por'
  768:17   string       mod=2 'ASSOCIATED_WITH se não houver relação mais específica)'
  770:9    string       mod=2 'CONECTIVOS CAUSAIS: se um nome candidato codifica uma relação'
  771:9    string       mod=2 '("IA_Para_Otimizacao"), divida em dois conceitos e expresse o link como chain.'
  772:9    string       mod=2 'Errado: IA_Para_Otimizacao'
  773:9    string       mod=2 'Certo:  chain: Artificial_Intelligence -> APPLIES -> Combinatorial_Optimization'
  775:9    string       mod=2 'QUALIFICADORES CONTEXTUAIS: não crie nós de chain para período, amostra,'
  776:9    string       mod=2 'instituição, cargo ou rótulos de contexto (ex.: faixas de anos, nome de'
  777:9    string       mod=2 'empresa) salvo quando o trecho os trate como construtos independentes'
  778:9    string       mod=2 'em investigação. Contexto vai em `trecho`.'
  780:9    string       mod=2 'Forma preferida: Concept_A -> RELATION -> Concept_B (dois conceitos, uma relação).'
  782:9    string       mod=2 'SELEÇÃO DA RELAÇÃO — aplique o primeiro caso que corresponder ao texto:'
  784:9    string       mod=2 'CASO APPLIES:'
  785:13   string       mod=2 'O texto afirma que um método, modelo ou framework é aplicado a,'
  786:13   string       mod=2 'usado em, ou exemplificado em um objeto ou contexto?'
  787:13   string       mod=2 'SIM → APPLIES. Direção: método/framework à ESQUERDA, objeto à DIREITA.'
  788:13   string       mod=2 'Ex: "aprendizado federado aplicado a redes veiculares"'
  789:13   string       mod=2 '→ Federated_Learning -> APPLIES -> Vehicular_Networks'
  791:9    string       mod=2 'CASO USES:'
  792:13   string       mod=2 'O texto afirma que um conceito emprega outro como instrumento,'
  793:13   string       mod=2 'insumo ou componente — dentro de um contexto metodológico?'
  794:13   string       mod=2 'SIM → USES. Direção: conceito que emprega à ESQUERDA, instrumento à DIREITA.'
  795:13   string       mod=2 'Ex: "usamos metaheurísticas para resolver problemas de escalonamento"'
  796:13   string       mod=2 '→ Medical_Scheduling -> USES -> Metaheuristic'
  798:9    string       mod=2 'CASO MEASURES:'
  799:13   string       mod=2 'O texto afirma que um indicador, teste ou instrumento quantifica'
  800:13   string       mod=2 'ou operacionaliza um construto?'
  801:13   string       mod=2 'SIM → MEASURES. Direção: instrumento à ESQUERDA, construto à DIREITA.'
  802:13   string       mod=2 'Ex: "Índice H utilizado para avaliar sua produção em aprendizado de máquina"'
  803:13   string       mod=2 '→ H_Index -> MEASURES -> Machine_Learning'
  805:9    string       mod=2 'CASO PART_OF:'
  806:13   string       mod=2 'O texto afirma explicitamente que A é parte, componente, dimensão,'
  807:13   string       mod=2 'tipo ou subconjunto de B (usando palavras como "parte", "componente",'
  808:13   string       mod=2 '"dimensão", "tipo", "subconjunto", "inclui")?'
  809:13   string       mod=2 'SIM → PART_OF. Direção: parte à ESQUERDA, todo à DIREITA.'
  810:13   string       mod=2 'Ex: "redes neurais são o núcleo do aprendizado de máquina"'
  811:13   string       mod=2 '→ Neural_Network -> PART_OF -> Machine_Learning'
  812:13   string       mod=2 'NÃO use para enquadramento contextual ou de domínio ("IA no contexto de saúde").'
  814:9    string       mod=2 'CASO PREDICTS:'
  815:13   string       mod=2 'O texto relata uma associação empírica onde A está ligado a variação'
  816:13   string       mod=2 'em B, sem afirmar mecanismo ou suficiência?'
  817:13   string       mod=2 'SIM → PREDICTS. Direção: fator à ESQUERDA, resultado à DIREITA.'
  818:13   string       mod=2 'NÃO use quando o texto afirma mecanismo ou condição suficiente — use ENABLES.'
  819:13   string       mod=2 'NÃO use quando o texto afirma bloqueio ou redução — use INHIBITS.'
  820:13   string       mod=2 'DÚVIDA entre PREDICTS e ENABLES: o texto apenas reporta covariação'
  821:13   string       mod=2 '(PREDICTS) ou afirma que A torna B possível / cria a condição para B'
  822:13   string       mod=2 'existir (ENABLES)? Se só covariação, use PREDICTS.'
  824:9    string       mod=2 'CASO ENABLES:'
  825:13   string       mod=2 'O texto afirma que A cria condição, mecanismo ou suficiência para B'
  826:13   string       mod=2 'ocorrer, se expandir ou se tornar possível?'
  827:13   string       mod=2 'SIM → ENABLES. Direção: condição à ESQUERDA, resultado à DIREITA.'
  828:13   string       mod=2 'Ex: "privacidade diferencial permitiu conformidade com regulação sem'
  829:13   string       mod=2 'perda de utilidade do modelo"'
  830:13   string       mod=2 '→ Differential_Privacy -> ENABLES -> Regulatory_Compliance'
  831:13   string       mod=2 'NÃO use quando o texto apenas reporta covariação estatística sem'
  832:13   string       mod=2 'mecanismo — use PREDICTS.'
  834:9    string       mod=2 'CASO INHIBITS:'
  835:13   string       mod=2 'O texto afirma que A reduz, bloqueia ou constrange B?'
  836:13   string       mod=2 'SIM → INHIBITS. Direção: inibidor à ESQUERDA, inibido à DIREITA.'
  838:9    string       mod=2 'CASO CONTRASTS_WITH:'
  839:13   string       mod=2 'O texto opõe explicitamente dois CONSTRUTOS REUTILIZÁVEIS usando'
  840:13   string       mod=2 'linguagem como "em vez de", "ao invés de", "diferente de"?'
  841:13   string       mod=2 'SIM → CONTRASTS_WITH.'
  842:13   string       mod=2 'NUNCA use para oposição entre qualificadores contextuais (período,'
  843:13   string       mod=2 'instituição, cargo, empresa). Se o contraste é entre contextos de'
  844:13   string       mod=2 'trajetória, registre apenas em memo.'
  846:9    string       mod=2 'CASO ASSOCIATED_WITH (fallback obrigatório):'
  847:13   string       mod=2 'Dois ou mais conceitos nomeados aparecem no mesmo trecho, mas'
  848:13   string       mod=2 'nenhum dos casos acima (APPLIES, USES, MEASURES, PART_OF,'
  849:13   string       mod=2 'PREDICTS, ENABLES, INHIBITS, CONTRASTS_WITH) é sustentado pelo'
  850:13   string       mod=2 'texto — incluindo o caso de simples co-ocorrência sem qualquer'
  851:13   string       mod=2 'vínculo semântico afirmado (ex.: áreas de atuação listadas juntas'
  852:13   string       mod=2 'no cabeçalho)?'
  853:13   string       mod=2 'SIM → ASSOCIATED_WITH. NÃO omita a chain neste caso: todo conceito'
  854:13   string       mod=2 'nomeado precisa entrar no grafo por alguma aresta.'
  855:13   string       mod=2 'Direção: sem direção preferencial semântica; registre na ordem em'
  856:13   string       mod=2 'que os conceitos aparecem no texto.'
  857:13   string       mod=2 'Para 3+ conceitos co-ocorrentes sem vínculo mais forte, crie um'
  858:13   string       mod=2 'par ASSOCIATED_WITH para cada par relevante citado no texto — não'
  859:13   string       mod=2 'infira pares entre conceitos que nunca aparecem próximos na frase.'
  861:9    string       mod=2 'CASO RELATES_TO:'
  862:13   string       mod=2 'Nenhum dos casos acima se aplica, incluindo ASSOCIATED_WITH (ex.:'
  863:13   string       mod=2 'o vínculo é direcional mas nenhuma relação nomeada captura bem'
  864:13   string       mod=2 'a natureza do link)?'
  865:13   string       mod=2 'SIM → RELATES_TO. Use em menos de 10% das chains — na prática,'
  866:13   string       mod=2 'ASSOCIATED_WITH cobre a quase totalidade dos casos de fallback.'
  867:13   string       mod=2 'NUNCA use em zonas Producao_Bibliografica ou Pesquisa_Projetos se'
  868:13   string       mod=2 'uma relação mais específica for defensável.'
  870:9    string       mod=2 'NORMALIZAÇÃO DE DIREÇÃO — antes de escrever a chain, verifique o verbo:'
  871:9    string       mod=2 "'requer', 'depende de', 'precisa de'"
  872:13   string       mod=2 '→ dependência à ESQUERDA: Dependency -> ENABLES -> Outcome'
  873:9    string       mod=2 "'é limitado por', 'é bloqueado por', 'é restringido por'"
  874:13   string       mod=2 '→ limitador à ESQUERDA: Limiter -> INHIBITS -> Constrained'
  875:9    string       mod=2 "'leva a', 'resulta em', 'causa'"
  876:13   string       mod=2 '→ causa à ESQUERDA: use ENABLES se o texto afirma mecanismo ou'
  877:15   string       mod=2 'suficiência; use PREDICTS se o texto apenas reporta covariação.'
  878:9    string       mod=2 "'permite', 'possibilita', 'viabiliza'"
  879:13   string       mod=2 '→ facilitador à ESQUERDA: Enabler -> ENABLES -> Outcome'
  880:9    string       mod=2 "'é aplicado a', 'é usado para estudar', 'no contexto de'"
  881:13   string       mod=2 '→ método/domínio à ESQUERDA: Method -> APPLIES -> Object'
  882:9    string       mod=2 "'usa', 'emprega', 'utiliza como instrumento'"
  883:13   string       mod=2 '→ conceito que emprega à ESQUERDA: Concept -> USES -> Instrument'
  884:9    string       mod=2 "'avalia', 'quantifica', 'classifica'"
  885:13   string       mod=2 '→ indicador à ESQUERDA: Indicator -> MEASURES -> Construct'
  886:9    string       mod=2 "'em vez de', 'ao invés de', 'diferente de'"
  887:13   string       mod=2 '→ primeiro construto mencionado à ESQUERDA: Concept_A -> CONTRASTS_WITH -> Concept_B'
  889:9    string       mod=2 'COMPRIMENTO DA CHAIN:'
  890:9    string       mod=2 'Prefira chains de dois conceitos. Três ou mais conceitos apenas quando o'
  891:9    string       mod=2 'texto afirma explicitamente uma sequência que não pode ser dividida em'
  892:9    string       mod=2 'pares independentes.'
  893:9    string       mod=2 'Teste: cada link pode ser ancorado independentemente no texto?'
  894:9    string       mod=2 'SIM → divida em chains separadas.'
  895:9    string       mod=2 'NÃO → mantenha como uma chain sequencial.'
  896:9    string       mod=2 'Nunca adicione um salto para codificar contexto de instituição/período —'
  897:9    string       mod=2 'contexto vai em memo.'
  898:9    string       mod=2 'Não infira transitividade: A->B e B->C não autoriza A->B->C salvo se o'
  899:9    string       mod=2 'texto afirma o caminho completo como uma única afirmação.'
  901:9    string       mod=2 'FATORES PARALELOS (mesmo resultado, múltiplos fatores independentes):'
  902:9    string       mod=2 'Crie uma chain por par fator->resultado dentro do mesmo ITEM.'
  903:9    string       mod=2 'Teste: cada link fator->resultado sustenta-se sozinho com sua própria âncora?'
  904:9    string       mod=2 'SIM → chains paralelas, uma por par.'
  905:9    string       mod=2 'Não mescle fatores independentes em uma única chain.'
  907:9    string       mod=2 'COBERTURA:'
  908:9    string       mod=2 'Todo conceito usado em uma chain DEVE ter uma entrada ONTOLOGY.'
  909:9    string       mod=2 'Não repita Concept_A -> Concept_B dentro do mesmo SOURCE salvo se'
  910:9    string       mod=2 'a relação for claramente diferente.'
  911:9    string       mod=2 'chain'
  911:15   string       mod=2 'é o único mecanismo de registro de conceito no grafo; é'
  912:9    string       mod=2 'OPCIONAL apenas no sentido de que um ITEM sem nenhum conceito'
  913:9    string       mod=2 'nomeado (puramente factual, ex.: apenas data ou cargo) pode não ter'
  914:9    string       mod=2 'chain'
  914:15   string       mod=2 '— mas se dois ou mais conceitos nomeados aparecem, ao menos'
  915:9    string       mod=2 'uma chain (com ASSOCIATED_WITH como piso) é esperada. Toda chain'
  916:9    string       mod=2 'exige memo no mesmo ITEM (OPTIONAL BUNDLE chain, memo em ITEM'
  917:9    string       mod=2 'FIELDS'
  917:16   string       mod=2 '— validado pelo compilador; ver FIELD memo).'
  919:9    string       mod=2 'RESTRIÇÃO PESQUISA_PROJETOS / IDENTIFICACAO_RESUMO:'
  920:9    string       mod=2 'Um trecho que lista linhas de pesquisa ou declara áreas de interesse'
  921:9    string       mod=2 'enuncia intenção de investigar, não um vínculo estabelecido. NÃO use'
  922:9    string       mod=2 'relações causais/de aplicação (APPLIES, ENABLES, PREDICTS etc.)'
  923:9    string       mod=2 'nessas zonas apenas porque dois conceitos são co-mencionados como'
  924:9    string       mod=2 'área de atuação. Se necessário registrar a co-menção, use'
  925:9    string       mod=2 'ASSOCIATED_WITH ou RELATES_TO (ver guia de relação por zona abaixo) —'
  926:9    string       mod=2 'nunca inferir um vínculo mais forte do que o texto sustenta.'
  928:9    string       mod=2 'Guia de relação por zona:'
  929:9    string       mod=2 'Formacao_Academica     → preferidos: PART_OF, USES, ASSOCIATED_WITH (fallback)'
  930:9    string       mod=2 'Atuacao_Profissional   → preferidos: APPLIES, ASSOCIATED_WITH'
  931:9    string       mod=2 'Pesquisa_Projetos      → preferidos: APPLIES, ENABLES, ASSOCIATED_WITH (fallback)'
  932:9    string       mod=2 'Producao_Bibliografica → preferidos: PREDICTS, ENABLES, MEASURES, ASSOCIATED_WITH (fallback)'
  933:9    string       mod=2 'Orientacoes_Bancas     → preferidos: ENABLES, ASSOCIATED_WITH'
  934:9    string       mod=2 'Premios_Titulos        → preferidos: MEASURES, CONTRASTS_WITH'
  935:9    string       mod=2 'Producao_Tecnica       → preferidos: APPLIES, USES'
  936:9    string       mod=2 'Identificacao_Resumo   → preferidos: ASSOCIATED_WITH ou RELATES_TO para'
  937:22   string       mod=2 'co-menção de área (chains causais/de aplicação são raras'
  938:22   string       mod=2 'nesta zona — ver RESTRIÇÃO PESQUISA_PROJETOS/IDENTIFICACAO_RESUMO)'
  940:9    string       mod=2 'Exemplo few-shot (relação específica):'
  941:9    string       mod=2 'Trecho: "Índice H utilizado para avaliar sua produção em aprendizado de máquina"'
  942:9    string       mod=2 '→ chain: H_Index -> MEASURES -> Machine_Learning'
  944:9    string       mod=2 'Exemplo few-shot (fallback ASSOCIATED_WITH):'
  945:9    string       mod=2 'Trecho: "Atuo nas áreas de otimização, aprendizado de máquina e'
  946:17   string       mod=2 'sistemas complexos."'
  947:9    string       mod=2 '→ chain: Optimization -> ASSOCIATED_WITH -> Machine_Learning'
  948:9    string       mod=2 '→ chain: Machine_Learning -> ASSOCIATED_WITH -> Complex_Systems'
  949:9    string       mod=2 '(áreas de atuação autodeclaradas no cabeçalho, sem projeto ou'
  950:9    string       mod=2 'mecanismo que as ligue — ASSOCIATED_WITH registra a co-ocorrência'
  951:9    string       mod=2 'sem forçar uma relação mais forte que o texto não sustenta)'
