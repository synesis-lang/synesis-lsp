  667:9    string       mod=2 'DUAS FUNÇÕES DESTE CAMPO:'
  669:9    string       mod=2 '1'
  669:10   string       mod=2 '. AUDITORIA DE CHAIN (substitui o antigo campo `note` pareado):'
